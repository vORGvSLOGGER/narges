# انسخ هذا الملف إلى .env واملأ القيم. (.env غير مرفوع لـ git)

# Gemini Vision API — للتعرف على المنتجات بالصورة (لوحة الكاشير)
# https://aistudio.google.com/apikey
VITE_GEMINI_KEY=

# Supabase — من: Supabase Dashboard → Project Settings → API
# هذه القيم آمنة للواجهة الأمامية (anon key عام محمي بسياسات RLS)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
